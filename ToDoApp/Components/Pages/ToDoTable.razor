@using ToDoApp.Models
<div class="table-responsive mt-2">
    <table class="table table-hover table-bordered align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 10%;">#</th>
                <th>To Do Task</th>
                <th class="text-center" style="width: 25%;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (filteredTodoItems.tasks.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">
                        No tasks found.
                    </td>
                </tr>
            }
            else
            {
                @for (int i = 0; i < filteredTodoItems.tasks.Count; i++)
                {
                    var task = filteredTodoItems.tasks[i];
                    <tr @key="task.id">
                        <td>@(i + 1)</td>
                        <td>
                            @if (task.isEdit)
                            {
                                <input type="text"
                                       class="form-control"
                                       @bind="task.text" />
                            }
                            else
                            {
                                <span class="@(task.isDone ? "text-decoration-line-through" : "")">
                                    @task.text
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            @if (task.isEdit)
                            {
                                <button class="btn btn-success btn-sm me-2"
                                        @onclick="() => HandleEditTaskText(task.id)">
                                    Save Changes
                                </button>
                                <button class="btn btn-secondary btn-sm"
                                        @onclick="() => HandleCancelEditTask(task.id)">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                @if (!task.isDone)
                                {
                                    <button class="btn btn-success btn-sm me-2"
                                            @onclick="() => HandleMarkAsCompleted(task.id)">
                                        Mark as Completed
                                    </button>
                                    <button class="btn btn-primary btn-sm me-2"
                                            @onclick="() => HandleEditTask(task.id)">
                                        Edit
                                    </button>
                                }
                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => HandleDeleteTask(task.id)">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@code {
    [Parameter]
    public ToDoTasks todoItems { get; set; } = new();
    [Parameter]
    public ToDoTasks filteredTodoItems { get; set; } = new();
    [Parameter]
    public EventCallback OnTasksChanged { get; set; }
    private string originalTaskText = string.Empty;
    public async Task HandleMarkAsCompleted(Guid taskId)
    {
        var task = todoItems.tasks.FirstOrDefault(t => t.id == taskId);
        if (task != null)
        {
            task.isDone = true;
        }
        await OnTasksChanged.InvokeAsync();
    }
    public async Task HandleDeleteTask(Guid taskId)
    {
        var task = todoItems.tasks.FirstOrDefault(t => t.id == taskId);
        if (task != null)
        {
            todoItems.tasks.Remove(task);
        }
        await OnTasksChanged.InvokeAsync();
    }
    public async Task HandleEditTask(Guid taskId)
    {
        var task = todoItems.tasks.FirstOrDefault(t => t.id == taskId);
        if (task != null)
        {
            originalTaskText = task.text;
            task.isEdit = true;
        }
        await OnTasksChanged.InvokeAsync();
    }
    public async Task HandleEditTaskText(Guid taskId)
    {
        var task = todoItems.tasks.FirstOrDefault(t => t.id == taskId);
        if (task != null)
        {
            task.text = task.text?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(task.text))
            {
                task.text = originalTaskText;
            }
            task.isEdit = false;
        }
        await OnTasksChanged.InvokeAsync();
    }
    public async Task HandleCancelEditTask(Guid taskId)
    {
        var task = todoItems.tasks.FirstOrDefault(t => t.id == taskId);
        if (task != null)
        {
            task.text = originalTaskText;
            task.isEdit = false;
        }
        await OnTasksChanged.InvokeAsync();
    }
}