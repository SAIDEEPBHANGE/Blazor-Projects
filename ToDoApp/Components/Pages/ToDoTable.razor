@using ToDoApp.Models
<div class="table-responsive mt-2">
    <table class="table table-hover table-bordered align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 10%;">#</th>
                <th>To Do Task</th>
                <th class="text-center" style="width: 25%;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (todoItems.tasks.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-4">
                        No tasks found.
                    </td>
                </tr>
            }
            else
            {
                @for (int i = 0; i < todoItems.tasks.Count; i++)
                {
                    var task = todoItems.tasks[i];
                    <tr>
                        <td>@(i+1)</td>
                        <td class="@(task.isDone ? "text-decoration-line-through" : "")">@task.text</td>
                        <td class="text-center">
                            @if (!task.isDone)
                            {    
                                <button class="btn btn-success btn-sm me-2" @onclick="@(() => HandleMarkAsCompleted(task.id))">
                                    Mark as Completed
                                </button>
                            }
                            <button class="btn btn-danger btn-sm" @onclick="@(() => HandleDeleteTask(task.id))">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@code{
    [Parameter]
    public ToDoTasks todoItems { get; set; } = new ToDoTasks();
    [Parameter]
    public ToDoTaskSummary toDoTaskSummary { get; set; } = new ToDoTaskSummary();

    private int rowId = 1;

    public async void HandleMarkAsCompleted(Guid taskId)
    {
        var task = todoItems.tasks.FirstOrDefault(t => t.id == taskId);
        if (task != null)
        {
            task.isDone = true;
        }
        toDoTaskSummary.Completed = todoItems.tasks.Count(t => t.isDone);
        toDoTaskSummary.Pending = toDoTaskSummary.Total - toDoTaskSummary.Completed;
        StateHasChanged();
    }
    public async void HandleDeleteTask(Guid taskId)
    {
        var task = todoItems.tasks.FirstOrDefault(t => t.id == taskId);
        if (task != null)
        {
            todoItems.tasks.Remove(task);
        }
        toDoTaskSummary.Total = todoItems.tasks.Count;
        toDoTaskSummary.Completed = todoItems.tasks.Count(t => t.isDone);
        toDoTaskSummary.Pending = toDoTaskSummary.Total - toDoTaskSummary.Completed;
        StateHasChanged();
    }
}