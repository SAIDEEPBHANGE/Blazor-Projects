@inject NavigationManager Navigation
<MudAppBar Elevation="1" Color="Color.Primary">
    <MudText Typo="Typo.h6" Class="ms-2">Personal Expense Tracker</MudText>
    <MudSpacer />
    <AuthorizeView>
        <Authorized>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="Logout">Logout</MudButton>
        </Authorized>
        <NotAuthorized>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/login">Login</MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudAppBar>
@code {
    private void Logout()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }
}
