@inject NavigationManager Navigation

<MudAppBar Elevation="1" Color="Color.Primary">
    <MudText Typo="Typo.h6" Class="ms-2">Personal Expense Tracker</MudText>
    <MudSpacer />

    <AuthorizeView>
        <Authorized>
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LogoutAsync">Logout</MudButton>
        </Authorized>
    </AuthorizeView>
</MudAppBar>

@code {
    private async Task LogoutAsync()
    {
        using var client = new HttpClient { BaseAddress = new Uri(Navigation.BaseUri) };
        await client.PostAsync("auth/logout", null);
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}

