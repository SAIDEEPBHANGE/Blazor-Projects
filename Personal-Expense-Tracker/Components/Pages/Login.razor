@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Login</PageTitle>
<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-10">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h5" Class="mb-4">Sign in</MudText>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@errorMessage</MudAlert>
        }
        <MudStack Spacing="2">
            <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-value="email" />
            <MudTextField T="string" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" @bind-value="password" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="isSubmitting" OnClick="LoginAsync">Login</MudButton>
            <MudText Typo="Typo.body2">No account? <MudLink Href="/register">Register</MudLink></MudText>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption">Admin: admin@expense.local / Admin@123</MudText>
            <MudText Typo="Typo.caption">User: user@expense.local / User@123</MudText>
        </MudStack>
    </MudPaper>
</MudContainer>
@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private bool isSubmitting;
    private string? errorMessage;
    private async Task LoginAsync()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Email and password are required.";
            return;
        }
        isSubmitting = true;
        try
        {
            var isSuccess = await JS.InvokeAsync<bool>("expenseTrackerAuth.postJson", "/auth/login?useCookies=true", new
            {
                Email = email.Trim(),
                Password = password
            });
            if (isSuccess)
            {
                var returnUrl = GetReturnUrlOrDefault();
                Navigation.NavigateTo(returnUrl, forceLoad: true);
                return;
            }
            errorMessage = "Invalid login attempt.";
        }
        catch
        {
            errorMessage = "Unable to sign in right now.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
    private string GetReturnUrlOrDefault()
    {
        var absoluteUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(absoluteUri.Query);
        if (!query.TryGetValue("ReturnUrl", out var returnUrl))
        {
            return "/";
        }
        var target = returnUrl.ToString();
        if (string.IsNullOrWhiteSpace(target) || !target.StartsWith('/'))
        {
            return "/";
        }
        return target;
    }
}
