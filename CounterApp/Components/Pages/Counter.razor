@page "/"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>
<div class="card shadow text-center">
    <div class="card-body p-5">
        <h1 class="card-title mb-4">Counter App</h1>
        <p role="status" class="display-1 fw-bold text-primary mb-3">@currentCount</p>
        <!-- Time -->
        <div class="text-muted mb-4">
            Current Time:
            <span class="fw-semibold" id="time"> @currTime </span>
        </div>
        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
            <button class="btn btn-success btn-lg" @onclick="IncrementCount">Add Counter</button>
            <button class="btn btn-danger btn-lg" @onclick="DecrementCount">Subtract Counter</button>
            <button class="btn btn-secondary btn-lg" @onclick="ResetCount">Reset Counter</button>
        </div>
    </div>
</div>


@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private void DecrementCount()
    {
        currentCount = Math.Max(--currentCount, 0);
    }

    private void ResetCount()
    {
        currentCount = 0;
    }

    private Timer? uiTimer;

    private string currTime = DateTime.Now.ToString("dd MMMM yyyy hh:mm:ss tt (zzz GMT)");

    protected override void OnInitialized()
    {
        uiTimer = new Timer(upDateTime, null, 0, 1000);
    }

    private void upDateTime(object? state)
    {
        currTime = DateTime.Now.ToString("dd MMMM yyyy hh:mm:ss tt (zzz GMT)");
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        uiTimer?.Dispose();
    }
}
